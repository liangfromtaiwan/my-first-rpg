rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isShortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // ---- Chat ----
    // Anyone signed in can read; you can only post as yourself. Messages can't be edited by others.
    match /messages/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isShortText(request.resource.data.text, 500);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 1:1 chats use "<uidA>_<uidB>" ids; private-room chats use "zone_..." ids.
    match /privateMessages/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && isShortText(request.resource.data.text, 500);
      allow update: if false;
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Video call state: only the two people in the conversation ("<uidA>_<uidB>").
    match /calls/{callId} {
      allow read, write: if signedIn() && request.auth.uid in callId.split('_');
    }

    // ---- Profiles & presence: only the owner can write ----
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isSelf(userId);
    }
    match /players/{playerId} {
      allow read: if signedIn();
      allow write: if isSelf(playerId);
    }

    // ---- Mini games ----
    match /gameInvites/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      // Only the inviter or the invitee can change an invite (accept / reject)
      allow update: if signedIn()
        && request.auth.uid in [resource.data.fromUid, resource.data.toUid];
      allow delete: if false;
    }

    match /gameSessions/{sessionId} {
      allow read: if signedIn();
      // Shared tic-tac-toe tables ("ttt_<map>_<table>") are open to everyone at the table
      allow write: if signedIn() && sessionId.matches('ttt_.*');
      // Icebreaker sessions: only the two players
      allow create: if signedIn()
        && !sessionId.matches('ttt_.*')
        && request.auth.uid in request.resource.data.players;
      allow update: if signedIn()
        && !sessionId.matches('ttt_.*')
        && request.auth.uid in resource.data.players;
    }

    // ---- Homes ("自己的家") ----
    // homes/{uid}: layout, colors and door mode. Everyone can look, only the owner can change it.
    match /homes/{ownerId} {
      allow read: if signedIn();
      allow write: if isSelf(ownerId);

      // Guestbook: visitors sign as themselves; the owner or the author can delete.
      match /guestbook/{entryId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && isShortText(request.resource.data.text, 200);
        allow update: if false;
        allow delete: if signedIn()
          && (request.auth.uid == ownerId || resource.data.authorUid == request.auth.uid);
      }

      // Door knocks: doc id is the visitor's uid.
      // The visitor creates / re-knocks; the owner answers (accept / decline).
      match /knocks/{visitorId} {
        allow read: if signedIn() && (request.auth.uid == ownerId || request.auth.uid == visitorId);
        allow create: if isSelf(visitorId) && request.resource.data.status == "pending";
        allow update: if (isSelf(visitorId) && request.resource.data.status == "pending")
          || (isSelf(ownerId) && request.resource.data.status in ["accepted", "declined"]);
        allow delete: if signedIn() && (request.auth.uid == ownerId || request.auth.uid == visitorId);
      }
    }
  }
}
